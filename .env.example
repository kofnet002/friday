DEEPGRAM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Optional — Claude model id. Leave unset to use the default claude-opus-4-8
# (most capable). Uncomment for lower latency/cost, e.g.:
# ANTHROPIC_MODEL=claude-sonnet-4-6
BACKEND_URL=http://127.0.0.1:8000
REDIS_URL=redis://127.0.0.1:6379

# ─── Agentic coding ("Claude Code" in the app) ────────────────────────────
# The coding panel's "Agent" button drives the local `claude` CLI to write,
# run, and fix code before answering. It bills against your Claude
# SUBSCRIPTION (not the metered Anthropic API), so no per-token cost.
# Setup: run `claude setup-token` in a terminal and paste the token below.
# See docs/agentic-coding.md.
AGENT_ENABLED=false
CLAUDE_CODE_OAUTH_TOKEN=
# Optional overrides:
# CLAUDE_CLI_PATH=claude          # absolute path if `claude` isn't on PATH
# CLAUDE_CONFIG_DIR=~/.claude-raymond   # CLI profile dir — use a separate Claude
#                                       # login/subscription for the app
# AGENT_TIMEOUT_S=240             # wall-clock kill per run (runaway guardrail)
# AGENT_MODEL=                    # e.g. claude-opus-4-8; empty = CLI default
# CLAUDE_VISION_MODEL=claude-opus-4-8   # Claude model for screen→problem OCR;
#                                       # set a faster Claude if the watch loop lags
# VISION_COOLDOWN_S=25            # after a problem is detected, don't re-run the
#                                 # vision model for N s (cuts quota churn); 0 = off
# VISION_PROVIDER=openai          # pin screen→problem detection to a fast/reliable
#                                 # model while solves still use the selected one
#                                 # (Claude). "" = follow the coding provider.
