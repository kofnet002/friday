# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
out/
.next/
.turbo/
*.tsbuildinfo
# `build/` is intentionally NOT broadly ignored — apps/desktop/build/ holds
# versioned icon assets. Per-app build dirs are listed below.

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Env
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Electron
apps/desktop/dist/
apps/desktop/app/

# apps/desktop/build/ holds versioned icon.svg + icon.icns. Everything else
# under it is regenerable: Release/ is Swift output (build:swift),
# icon.iconset/ is rasterized PNGs (build:icon).
apps/desktop/build/Release/
apps/desktop/build/icon.iconset/

# SQLite (local session/context data)
apps/backend/data/

# Coverage
coverage/
.nyc_output/

.claude
# Packaged-app staging (apps/desktop) and PyInstaller work dir (apps/backend)
apps/desktop/bundle/
apps/backend/build/
