{
  "name": "@friday/desktop",
  "version": "0.0.7",
  "private": true,
  "main": "main.js",
  "build": {
    "appId": "dev.friday.desktop",
    "productName": "Friday",
    "electronDist": "node_modules/electron/dist",
    "publish": [
      {
        "provider": "github",
        "owner": "kofnet002",
        "repo": "friday",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "packaging"
    },
    "files": [
      "main.js",
      "preload.js",
      "audio.js",
      "coding.js",
      "scan.js",
      "updater.js",
      "stealth.js",
      "services.js",
      "parent-watchdog.js",
      "build/Release/*.node",
      "build/icon.icns"
    ],
    "asarUnpack": [
      "build/Release/*.node",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "bundle/backend",
        "to": "backend"
      },
      {
        "from": "bundle/friday-audio",
        "to": "friday-audio"
      },
      {
        "from": "bundle/env.example",
        "to": "env.example"
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Friday can transcribe your microphone during a session.",
        "NSAudioCaptureUsageDescription": "Friday transcribes system audio during a session."
      }
    }
  },
  "scripts": {
    "dev": "wait-on -t 60000 http://127.0.0.1:3333 && cross-env NODE_ENV=development electron .",
    "build": "pnpm run build:swift && pnpm run build:native:stealth && pnpm run build:icon",
    "build:swift": "swift build -c release --package-path swift",
    "build:native:stealth": "node scripts/build-native-stealth.js",
    "build:icon": "node scripts/build-icon.js",
    "stage": "node scripts/stage-bundle.js",
    "prepare:package": "pnpm --filter @friday/web build && pnpm --filter @friday/backend build:binary && pnpm run build && pnpm run stage",
    "dist": "pnpm run prepare:package && electron-builder --mac --publish never -c.mac.identity=-",
    "release:mac": "node scripts/release-mac.js",
    "postinstall": "pnpm run build || true",
    "lint": "echo 'desktop lint not configured yet'",
    "typecheck": "echo 'desktop typecheck not configured yet'",
    "test": "node --test"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.11",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.49.1",
    "wait-on": "^8.0.1"
  }
}
