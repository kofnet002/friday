{
  "name": "@friday/desktop",
  "version": "0.0.1",
  "private": true,
  "main": "main.js",
  "build": {
    "extendInfo": {
      "LSUIElement": true,
      "NSMicrophoneUsageDescription": "Friday listens to your microphone so it can tell when you are speaking during an interview."
    }
  },
  "scripts": {
    "dev": "wait-on -t 60000 http://127.0.0.1:3333 && cross-env NODE_ENV=development electron .",
    "build": "pnpm run build:swift && pnpm run build:native:stealth && pnpm run build:icon",
    "build:swift": "swift build -c release --package-path swift",
    "build:native:stealth": "node scripts/build-native-stealth.js",
    "build:icon": "node scripts/build-icon.js",
    "postinstall": "pnpm run build || true",
    "lint": "echo 'desktop lint not configured yet'",
    "typecheck": "echo 'desktop typecheck not configured yet'"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "wait-on": "^8.0.1"
  }
}
